# Change this before first run. Never commit the real .env.
WEBHOST_ADMIN_PASSWORD=Coloca_aqui_uma_password_forte_e_unica
# Adjust to the real ZimaOS host path
WEBHOST_DATA_DIR=/DATA/AppData/MrStore_webhost/data
# For direct LAN access replace 127.0.0.1 with LAN IP or 0.0.0.0.
WEBHOST_PANEL_BIND_IP=127.0.0.1
WEBHOST_SITE_BIND_IP=127.0.0.1

# DEDICATED Docker rootless daemon socket. Do not use /var/run/docker.sock.
WEBHOST_ROOTLESS_SOCKET=/run/user/1000/docker.sock
WEBHOST_UID=1000
WEBHOST_GID=1000
